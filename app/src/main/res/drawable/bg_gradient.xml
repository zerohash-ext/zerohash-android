<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle top-to-bottom dark gradient (barely-green evergreen fading to near-black)
     for a more refined background than a flat green fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FF12201A"
        android:endColor="#FF090C0A" />
</shape>
